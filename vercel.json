{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "balderbageri.sigmaaxel.se" }],
      "destination": "https://www.balderbageri.se/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/:file",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/:file",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/:file(icon-192.png|icon-512.png|favicon-192.png|apple-touch-icon.png|og-image.png|favicon.svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
